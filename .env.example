# ==============================================================================
# TRAVELGURU CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and configure your credentials.
# NEVER commit .env to public version control or expose secret keys in frontend code.

# Server Configuration
PORT=3000
NODE_ENV=production

# Your deployed website URL (used for CORS policy)
# Update this to your actual deployment domain.
SITE_URL=https://travelguru.com

# Google Maps Platform (Optional - backend proxy for Distance Matrix & Geocoding)
# If left blank, the platform automatically utilizes its high-precision built-in
# Indian geospatial highway network matrix and standard Google Maps client embeds.
# Get your API key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# OpenRouteService / OSRM API Key (Alternative routing engine - Optional)
# Free sign-up at: https://openrouteservice.org/
OPENROUTE_API_KEY=

# OpenWeatherMap API Key (Optional for live destination weather forecast)
# Free sign-up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Booking & Hospitality Affiliate Identifiers (Optional for affiliate tracking)
# Leave blank to redirect users directly to standard search URLs.
BOOKING_COM_AFFILIATE_ID=
AGODA_AFFILIATE_ID=
MAKEMYTRIP_AFFILIATE_ID=

# Transport APIs (Optional - for direct partner PNR queries)
IRCTC_PARTNER_KEY=
